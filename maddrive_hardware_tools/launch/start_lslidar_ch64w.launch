<launch>
    <arg name="device_ip" default="192.168.1.164" />
    <arg name="prefix" default=""/>
    <arg name="msop_port" default="2340" />
    <arg name="difop_port" default="2341" />
    <arg name="lidar_type" default="ch64w"/>
    <arg name="pcl_type" default="false"/>
    <arg name="use_time_service" default="false" />
    <arg name="rviz" default="false" />

  <node pkg="lslidar_ch64w_driver" type="lslidar_ch_driver_node" name="lslidar_ch64w_driver_node" output="screen">
    <!--param name="pcap" value="$(find lslidar_ch64w_driver)/pcap/123.pcap"/-->
    <param name="lidar_ip" value="$(arg device_ip)"/>
    <param name="lidar_type" value="$(arg lidar_type)"/>
    <param name="msop_port" value="$(arg msop_port)" />
    <param name="difop_port" value="$(arg difop_port)"/>
    <param name="pcl_type" value="$(arg pcl_type)"/>
    <param name="add_multicast" value="false"/>
    <param name="group_ip" value="224.1.1.2"/>
    <param name="frame_id" value="$(arg prefix)lslidar_ch64w_pcl_link"/>
    <param name="min_range" value="0.15"/>
    <param name="max_range" value="500.0"/>
    <param name="packet_rate" value="11228.0"/>
    <param name="read_once" value="false"/>
    <param name="angle_disable_min" value="0"/>
    <param name="angle_disable_max" value="0"/>
    <Param name="pointcloud_topic" value="$(arg prefix)lslidar_ch64w_point_cloud"/>
    <param name="horizontal_angle_resolution" value="0.12"/>
    <param name="use_time_service" value="$(arg use_time_service)"/>
    <param name="use_gps" value="true"/>
    <param name="echo_num" value="0"/>
    <param name="publish_laserscan" value="false"/>
    <param name="channel_num" value="64"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find maddrive_hardware_tools)/rviz/lslidar_ch64w.rviz"/>

</launch>
