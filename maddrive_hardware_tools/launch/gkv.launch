<?xml version="1.0"?>
<launch>

    <arg name="rviz" default="false" />

    <node pkg="gkv_ros_driver" type="gkv_controller" name="gkv_controller" output="screen">
    </node>
    <node pkg="gkv_ros_driver" type="gkv_custom_data_parser.py" name="gkv_custom_data_parser" output="screen">
    </node>

    <!-- str2str (RTK popravki) -->
    <include file="$(find maddrive_hardware_tools)/launch/ntrip_2_device.launch">
        <arg name="login" value="msc9862" />
        <arg name="password" value="16ihqidp" />
        <arg name="ntrip_server" value="ntrip.eftgroup.ru" />
        <arg name="port" value="7052" />
        <arg name="mountpoint" value="NNV23_2" />
        <arg name="device" value="ttyGKV-3-extra" />
        <arg name="baudrate" value="115200" />
    </include>

    <!-- rviz -->
    <group if="$(arg rviz)">
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find maddrive_hardware_tools)/rviz/gkv.rviz" />
    </group>

</launch>
