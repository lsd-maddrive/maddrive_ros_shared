<?xml version="1.0"?>
<launch>

    <arg name="device" default="/dev/ttyArdusimple0" />
    <arg name="device_type" default="rover" doc="[rover, moving_base]" />

    <arg name="use_rtcm" default="false" />
    <arg if="$(arg use_rtcm)" name="rtcm_topic" default="/rtcm" />
    <arg unless="$(arg use_rtcm)" name="rtcm_topic" default="/no_rtcm" />

    <node pkg="ublox_gps" type="ublox_gps" name="ardusimple_$(arg device_type)"
        output="screen" clear_params="true" respawn="true">
        <rosparam command="load" file="$(find maddrive_hardware_tools)/config/gps/ardusimple_$(arg device_type).yaml" />
        <param name="device" value="$(arg device)"/>
        <remap from="rtcm" to="$(arg rtcm_topic)"/>
    </node>

</launch>